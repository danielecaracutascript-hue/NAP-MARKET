# Bitcoin Core RPC Configuration (regtest)
BITCOIN_RPC_URL=http://127.0.0.1:18443
BITCOIN_RPC_COOKIE_PATH=C:\btc-poc\regtest\.cookie

# Platform xpub (devi impostare questo valore)
# Genera con: node -e "const { bip39 } = require('bip39'); const btc = require('bitcoinjs-lib'); const d = require('@bitcoinerlab/descriptors'); const seed = bip39.mnemonicToSeedSync('tua mnemonic'); const master = d.BIP32.fromSeed(seed, btc.networks.testnet); const fp = Array.from(master.fingerprint).map(b => b.toString(16).padStart(2,'0')).join(''); const acct = master.derivePath(\"m/84'/1'/0'\"); console.log(\`[${fp}/84h/1h/0h]\${acct.neutered().toBase58()}\`);"
PLATFORM_XPUB=tua_platform_xpub_qui

# Escrow timelock blocks
ESCROW_CONCORDATA_BLOCKS=5
ESCROW_BUYER_TIMELOCK_BLOCKS=10
